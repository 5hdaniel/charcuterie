# Charcuterie Voter - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public API key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# ============================================
# GOOGLE GEMINI AI CONFIGURATION
# ============================================
# Get your API key from Google AI Studio:
# https://aistudio.google.com/app/apikey

# Your Google Gemini API key (used for generating item sketches)
VITE_API_KEY=your_google_gemini_api_key_here
